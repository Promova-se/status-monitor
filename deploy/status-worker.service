[Unit]
Description=Status - worker de monitoramento
After=network.target status-app.service

[Service]
Type=simple
User=status
WorkingDirectory=/opt/status
Environment=NODE_ENV=production
EnvironmentFile=/opt/status/.env
ExecStart=/usr/bin/npm run worker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
